# To get Real SMS and Email OTP working, fill these out and rename this file to .env

# --- SMS OTP: pick ONE of the two options below (Twilio is tried first if both are set) ---

# Option A — Twilio (works for any country, has a free trial credit)
# Get these from https://console.twilio.com after creating a free account:
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN -> Console dashboard
#   TWILIO_PHONE_NUMBER -> the Twilio number you were assigned (E.164 format, e.g. +15005550006)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Option B — Fast2SMS (India-only numbers, cheapest, no international support)
# Dashboard -> Dev API -> generate/regenerate your key: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Real Email Delivery (Gmail Nodemailer)
# Use your Gmail address and generate an "App Password" (Not your real password)
# Guide: https://support.google.com/accounts/answer/185833?hl=en
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# --- Forensic geolocation + VPN/Proxy/abuse threat intel (server/forensicTracer.js, server/vpnProxyIntel.js) ---
# All three below are optional and independent -- each one you set adds one more
# real, evidence-based source to the VPN/Proxy/Tor verdict; with none set the
# app still runs, just falling back to a weaker ISP-name heuristic.

# IPinfo.io — used both for geolocation consensus AND (this token specifically)
# the /privacy endpoint's real vpn/proxy/tor/relay/hosting flags.
# NOTE: privacy detection may require a paid IPinfo plan -- a free-tier token
# still works for geolocation, and simply reports privacy checks as unavailable.
# Get a token free at https://ipinfo.io/signup
IPINFO_TOKEN=your_ipinfo_token_here

# AbuseIPDB — community-reported abuse confidence score + usage type.
# Get a free API key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Shodan — host tags (vpn/proxy/tor/cloud/compromised), open ports, and known
# CVEs Shodan has matched on that host.
# Get an API key at https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# --- Async analysis pipeline (BullMQ + Redis) ---
# If Redis is running, email analysis is queued asynchronously (non-blocking).
# If Redis is NOT available, the server falls back to synchronous analysis.
# Start Redis in dev: docker run -d --name redis -p 6379:6379 redis:7-alpine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here  # Optional, only if Redis requires auth

# Number of emails to analyze concurrently (per worker process)
WORKER_CONCURRENCY=4

# --- Advanced AI Threat Analysis Engine (server/advancedAiAnalyzer.js) ---
# All of this is OPTIONAL. With nothing set below, analyzeEmail() runs exactly
# as it always has -- deterministic rules + the offline TF-IDF classifier --
# and every email's advancedAiReport.engine.mode will read "heuristic".
# Configure ANY ONE provider to switch individual analyses to mode "llm"; the
# provider chain below tries them in order and fails over automatically.

# Master switch -- set to false to force heuristic-only mode even with keys present.
AI_ANALYSIS_ENABLED=true

# Order to try providers in, comma-separated. First configured + healthy wins.
AI_PROVIDER_CHAIN=openai,anthropic,ollama

# Option A -- OpenAI (or any OpenAI-compatible endpoint: Azure OpenAI, vLLM, LM Studio)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option B -- Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Option C -- Ollama (local models, zero cost, zero data leaves this machine)
# Requires `ollama serve` running locally with a model pulled, e.g.:
#   ollama pull llama3.1:8b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cost control -- skip the LLM when the deterministic engine is already
# confident (score below AI_TRIAGE_LOW or above AI_TRIAGE_HIGH), UNLESS the
# message is fraud-shaped (BEC/lookalike domain/attachment/prompt-injection),
# which always gets a full AI review regardless of score.
AI_TRIAGE_LOW=12
AI_TRIAGE_HIGH=85
# AI_ALWAYS_ANALYZE=true   # uncomment to send every message to the LLM (higher cost)

# Vector-embedding campaign tracking (server/ai/campaignTracker.js). Falls back
# automatically to a free, offline, dependency-free local hasher when no
# embedding-capable provider is configured -- clustering still works with $0 spend.
AI_EMBEDDINGS_ENABLED=true
